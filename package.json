{
  "name": "@phantasywind/nidec-app-ui-design",
  "version": "0.1.0",
  "private": false,
  "description": "Shared, governed UI foundations for Nidec applications.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phantasywind/nidec-app-ui-design.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "./dist/tokens.css"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts.d.ts",
      "import": "./dist/layouts.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.js"
    },
    "./tokens.css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "eslint eslint.config.js scripts",
    "typecheck": "tsc -p tsconfig.json",
    "tokens:build": "node scripts/build-tokens.mjs && node scripts/build-theme-demo.mjs",
    "css:check": "node scripts/check-css-scope.mjs && node scripts/check-colors.mjs && node scripts/build-theme-demo.mjs --check",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "test": "npm run tokens:build && vitest run",
    "build": "npm run clean && npm run tokens:build && vite build && tsc -p tsconfig.build.json && npm run css:check",
    "pack:verify": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "consumer:verify": "node scripts/verify-consumer.mjs",
    "rollback:verify": "node scripts/verify-stage3-rollback.mjs",
    "publication:check": "node scripts/check-publication.mjs",
    "release:authorize": "node scripts/check-release-authorization.mjs",
    "adoption:check": "node scripts/verify-adoption-record.mjs",
    "prepublishOnly": "npm run publication:check && npm run release:authorize",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test && npm run boundaries:check && npm run adoption:check",
    "verify:stage3e": "npm run verify && npm run pack:verify && npm run consumer:verify",
    "verify:stage3f": "npm run verify:stage3e && npm run rollback:verify"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-datepicker-compat": "0.6.39",
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "peerDependenciesMeta": {
    "@fluentui/react-components": {
      "optional": true
    },
    "@fluentui/react-datepicker-compat": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-datepicker-compat": "0.6.39",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
