{
  "name": "@phantasywind/nidec-app-ui-design",
  "version": "0.0.0-development",
  "private": true,
  "description": "Shared, governed UI foundations for Nidec applications.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phantasywind/nidec-app-ui-design.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "eslint eslint.config.js scripts",
    "typecheck": "tsc -p tsconfig.json",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json",
    "verify": "npm run lint && npm run typecheck && npm run boundaries:check && npm run build && npm run boundaries:check"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
